<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Darak third-party licenses</title>
<style>
body { font-family: "Segoe UI", sans-serif; max-width: 960px; margin: 2rem auto; padding: 0 1rem; color: #222; }
h2 { margin-top: 2.5rem; border-bottom: 1px solid #ddd; padding-bottom: .3rem; }
ul.crates { columns: 2; font-size: .9rem; }
pre { white-space: pre-wrap; background: #f6f6f6; padding: 1rem; font-size: .8rem; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>Darak is built from the Rust crates below. Each license is listed once with the crates that use it.</p>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<ul class="crates">
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
